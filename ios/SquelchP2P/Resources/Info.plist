<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.7.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Bluetooth Usage Descriptions (spec section 4.1) -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Squelch uses Bluetooth to route encrypted messages when Wi-Fi or the internet is unavailable.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Squelch uses Bluetooth to find peers nearby for offline chat.</string>

    <!-- Local network permission (MultipeerConnectivity requires this on iOS 14+) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Squelch uses the local Wi-Fi network to discover nearby peers for offline chat.</string>

    <!-- MultipeerConnectivity Bonjour services - matching `SquelchP2P/Sources/IOSMeshManager.swift` -->
    <key>NSBonjourServices</key>
    <array>
        <string>_squelch-mesh._tcp</string>
        <string>_squelch-mesh._udp</string>
    </array>

    <!-- Granular local network services (iOS 14+) -->
    <key>NSLocalNetworkServices</key>
    <array>
        <dict>
            <key>_squelch-mesh._tcp</key>
            <string>Squelch offline mesh (TCP).</string>
        </dict>
        <dict>
            <key>_squelch-mesh._udp</key>
            <string>Squelch offline mesh (UDP).</string>
        </dict>
    </array>

    <!-- Background modes: keep the mesh alive while suspended. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
    </array>
</dict>
</plist>
