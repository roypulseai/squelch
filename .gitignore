# Google OAuth / Service account JSONs - never commit
client_secret_*.json
service_account*.json
*.gserviceaccount.com

# Release keystores - the public repo ships the example + setup
# script; the real .jks stays out of git.
keystore/*.jks
*.jks
*.keystore

# Stray client_secret JSONs sometimes get downloaded into the parent
# dir by PowerShell when running OAuth tooling. Ignore at the project
# root as well.
/client_secret_*.json
