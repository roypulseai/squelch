<?xml version="1.0" encoding="utf-8"?>
<!--
    Reference copy of res/values/oauth_credentials.xml.
    This file is intentionally NOT compiled into the APK. The real file
    (oauth_credentials.xml) is the source the app reads.

    A copy of this example file lives at docs/oauth_credentials.example.xml
    for contributors who don't want to touch the production credentials.
-->
<resources>
    <string name="google_client_id">REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com</string>
    <string name="drive_scope" translatable="false">https://www.googleapis.com/auth/drive.file</string>
    <string name="userinfo_scope" translatable="false">https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile</string>
    <string name="google_account_type" translatable="false">com.google</string>
</resources>
