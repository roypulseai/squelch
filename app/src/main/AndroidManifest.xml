<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- v2 baseline. Auth/Drive/Nearby/foreground-service permissions
         will be added when those layers are scaffolded. -->

    <application
        android:name=".SquelchApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Squelch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Squelch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Drive REST API needs an OAuth client id resolved at runtime.
             We do NOT use Firebase; the app is configured entirely via
             res/values/oauth_credentials.xml. -->

    </application>
</manifest>
