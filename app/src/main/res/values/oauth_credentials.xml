<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Sign-In + Google Drive REST API credentials for Squelch P2P.

    This file is committed to the repo as a PLACEHOLDER ONLY. Replace the
    values below with your real OAuth client before building a signed APK:

        1. Go to https://console.cloud.google.com/  (project owned by
           the Google account roypulseai / roypulse.ai@gmail.com).
        2. APIs & Services -> OAuth consent screen: configure for external
           users; add scopes "openid", "email", "profile", and the Google
           Drive API scope "drive.file" (https://www.googleapis.com/auth/drive.file).
        3. APIs & Services -> Credentials -> Create credentials ->
           OAuth client ID -> Android application.
           Set the package name to com.squelch.p2p and use the SHA-1 of
           your signing keystore (./gradlew signingReport will print it).
        4. Copy the client id string into the placeholder below.
        5. (Optional but recommended) Set up a SHA-1 per-build:
              ./gradlew signingReport
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingTranslation">

    <!-- OAuth 2.0 Web client id (used for the Google Sign-In request AND
         for offline Drive API access via the sign-in token). Replace
         the placeholder. Format: <digits>-<hash>.apps.googleusercontent.com -->
    <string name="google_client_id">REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com</string>

    <!-- Drive scope used by the REST API to manage /squelch/vault.enc.
         Spec section 2.1 chose drive.file (app-created files only). -->
    <string name="drive_scope" translatable="false">https://www.googleapis.com/auth/drive.file</string>

    <!-- Userinfo scope pair used to derive vault salt = SHA256(Google UID). -->
    <string name="userinfo_scope" translatable="false">https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile</string>

    <!-- OAUTH 2.0 account type constant (Google). -->
    <string name="google_account_type" translatable="false">com.google</string>
</resources>
