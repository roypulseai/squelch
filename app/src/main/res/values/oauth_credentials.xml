<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Sign-In + Google Drive REST API credentials for Squelch.

    Google Cloud project (filled in by you):
        Project ID    squelch-p2p
        Project #     457905304802
        Project name  squelch
        Owner         roypulseai / roypulse.ai@gmail.com

    OAUTH CLIENT: create one (Android type, package com.squelch.app)
    under this project and paste its client id below. The OAuth client
    gives access to:

        drive.file              (manage /squelch/vault.enc)
        openid + email + profile (Google Sign-In identity / UID derivation)

    Steps to provision the OAuth client:

        1. APIs & Services -> Library -> enable Google Drive API.
        2. APIs & Services -> OAuth consent screen -> External -> create
           (scope = drive.file, plus openid/email/profile). Add yourself
           as a test user while the app is unpublished.
        3. APIs & Services -> Credentials -> Create credentials ->
           OAuth client ID -> Android. Set:
              package name = com.squelch.app
              SHA-1 fingerprint = your signing keystore SHA-1

    In production, set up TWO OAuth clients (one for debug, one for
    release) and swap the client id via the gradle build variant:
        debug       -> debug_oauth_client_id
        release     -> release_oauth_client_id
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingTranslation">

    <!-- OAuth 2.0 Web client id (used for the Google Sign-In request AND
         for offline Drive API access via the sign-in token). Replace
         the placeholder. Format: <digits>-<hash>.apps.googleusercontent.com -->
    <string name="google_client_id">457905304802-tmkcnrfn08t5lecetvvmnmf38j12o12r.apps.googleusercontent.com</string>

    <!-- Drive scope used by the REST API to manage /squelch/vault.enc.
         Spec section 2.1 chose drive.file (app-created files only). -->
    <string name="drive_scope" translatable="false">https://www.googleapis.com/auth/drive.file</string>

    <!-- Userinfo scope pair used to derive vault salt = SHA256(Google UID). -->
    <string name="userinfo_scope" translatable="false">https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile</string>

    <!-- OAUTH 2.0 account type constant (Google). -->
    <string name="google_account_type" translatable="false">com.google</string>
</resources>