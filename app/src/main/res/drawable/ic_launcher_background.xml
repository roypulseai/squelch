<?xml version="1.0" encoding="utf-8"?>
<!--
    Squelch launcher background - matte black with a soft amber radial
    halo behind the foreground so the icon has depth on the home screen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Solid deep-matte base. -->
    <path android:fillColor="#0A0A12"
        android:pathData="M0,0h108v108h-108z" />

    <!-- A centred amber halo drawn with two nested translucent rings.
         strokeWidth kept light so the foreground stays the focus. -->
    <path android:strokeColor="#FFB000" android:strokeAlpha="0.08"
        android:strokeWidth="10"
        android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0" />
    <path android:strokeColor="#FFB000" android:strokeAlpha="0.05"
        android:strokeWidth="20"
        android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0" />
</vector>
